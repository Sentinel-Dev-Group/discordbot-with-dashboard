# ─── Discord ───────────────────────────────────────────
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id
CLIENT_SECRET=your_application_client_secret

# Comma-separated list of Discord user IDs that are bot owners
OWNER_IDS=123456789012345678,987654321098765432

# ─── Dashboard OAuth ───────────────────────────────────
# Must match exactly what you set in Discord Developer Portal
# e.g. https://yourdomain.com/auth/callback
CALLBACK_URL=http://localhost:3000/auth/callback

# Random string — used to sign session cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_to_a_long_random_string

# ─── Database ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=botuser
DB_PASS=yourpassword
DB_NAME=discordbot

# ─── Dashboard ─────────────────────────────────────────
# Port the Express dashboard listens on
DASHBOARD_PORT=3000

# Full public URL of your dashboard (no trailing slash)
# Used for OAuth redirects and asset links
DASHBOARD_URL=http://localhost:3000

# ─── Bot behaviour ─────────────────────────────────────
# Default mute duration in minutes if none specified
DEFAULT_MUTE_MINUTES=10

# XP cooldown between messages in seconds (prevents spam farming)
XP_COOLDOWN_SECONDS=60

# Min and max XP awarded per eligible message
XP_MIN=15
XP_MAX=25

# ─── Logging ───────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info

#  twitch creds

TWITCH_CLIENT_ID=rzv0okny0ortmqb240tjk5nlwnblh7
TWITCH_CLIENT_SECRET=5ayxrs343zj89lfa3gozq4g75cbjr0
