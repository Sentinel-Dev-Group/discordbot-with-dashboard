<% locals.activePage = 'config' %>

<div class="page-header">
  <div class="page-header-left">
    <h2>Configuration</h2>
    <p class="page-subtitle">
      Manage settings for <strong><%= guild.discord?.name ?? guild.name %></strong>
    </p>
  </div>
</div>

<form method="POST" action="/dashboard/<%= guild.id %>/config">

  <!-- ─── Logging ──────────────────────────────────── -->
  <div class="card mb-4">
    <div class="card-header">
      <h3><i data-feather="terminal"></i> Logging</h3>
    </div>
    <div class="card-body">
      <div class="form-group">
        <label class="form-label">Log channel ID</label>
        <input
          type="text"
          name="log_channel"
          value="<%= config.log_channel ?? '' %>"
          placeholder="e.g. 123456789012345678"
          class="form-input"
        >
        <p class="form-hint">Channel where mod actions are posted.</p>
      </div>
    </div>
  </div>

  <!-- ─── Welcome ──────────────────────────────────── -->
  <div class="card mb-4">
    <div class="card-header">
      <h3><i data-feather="bell"></i> Welcome messages</h3>
    </div>
    <div class="card-body">
      <div class="form-group">
        <label class="form-label">Welcome channel ID</label>
        <input
          type="text"
          name="welcome_channel"
          value="<%= config.welcome_channel ?? '' %>"
          placeholder="e.g. 123456789012345678"
          class="form-input"
        >
        <p class="form-hint">Channel to send welcome messages in.</p>
      </div>
      <div class="form-group">
        <label class="form-label">Welcome message</label>
        <textarea
          name="welcome_message"
          rows="3"
          placeholder="Welcome {user} to {server}! You are member #{membercount}."
          class="form-input"
        ><%= config.welcome_message ?? '' %></textarea>
        <p class="form-hint">
          Available tokens:
          <code>{user}</code>
          <code>{username}</code>
          <code>{server}</code>
          <code>{membercount}</code>
        </p>
      </div>
    </div>
  </div>

  <!-- ─── Moderation ───────────────────────────────── -->
  <div class="card mb-4">
    <div class="card-header">
      <h3><i data-feather="shield"></i> Moderation</h3>
    </div>
    <div class="card-body">
      <div class="form-group">
        <label class="form-label">Mute role ID</label>
        <input
          type="text"
          name="mute_role"
          value="<%= config.mute_role ?? '' %>"
          placeholder="e.g. 123456789012345678"
          class="form-input"
        >
        <p class="form-hint">Role assigned when a member is muted.</p>
      </div>
    </div>
  </div>

  <!-- ─── Roles ─────────────────────────────────────── -->
  <div class="card mb-4">
    <div class="card-header">
      <h3><i data-feather="user-check"></i> Auto-role</h3>
    </div>
    <div class="card-body">
      <div class="form-group">
        <label class="form-label">Auto-role ID</label>
        <input
          type="text"
          name="auto_role"
          value="<%= config.auto_role ?? '' %>"
          placeholder="e.g. 123456789012345678"
          class="form-input"
        >
        <p class="form-hint">Role automatically assigned to new members on join.</p>
      </div>
    </div>
  </div>

  <!-- ─── Tickets ───────────────────────────────────── -->
  <div class="card mb-4">
    <div class="card-header">
      <h3><i data-feather="message-square"></i> Tickets</h3>
    </div>
    <div class="card-body">
      <div class="form-group">
        <label class="form-label">Ticket category ID</label>
        <input
          type="text"
          name="ticket_category"
          value="<%= config.ticket_category ?? '' %>"
          placeholder="e.g. 123456789012345678"
          class="form-input"
        >
        <p class="form-hint">Category channel where ticket channels are created.</p>
      </div>
      <div class="form-group">
        <label class="form-label">Ticket log channel ID</label>
        <input
          type="text"
          name="ticket_log"
          value="<%= config.ticket_log ?? '' %>"
          placeholder="e.g. 123456789012345678"
          class="form-input"
        >
        <p class="form-hint">Channel where closed tickets are logged.</p>
      </div>
    </div>
  </div>

  <!-- ─── Save ──────────────────────────────────────── -->
  <div class="form-actions">
    <button type="submit" class="btn btn-primary btn-lg">
      <i data-feather="save"></i>
      Save configuration
    </button>
    <a href="/dashboard/<%= guild.id %>" class="btn btn-outline">
      Cancel
    </a>
  </div>

</form>

<style>
.form-group    { margin-bottom: 20px; }
.form-group:last-child { margin-bottom: 0; }
.form-label    { display: block; font-size: 14px; font-weight: 600; margin-bottom: 6px; color: var(--text-secondary); }
.form-input    { width: 100%; padding: 10px 14px; background: var(--bg-input); border: 1px solid var(--border); border-radius: var(--radius-md); color: var(--text-primary); font-size: 14px; font-family: var(--font); outline: none; transition: border-color 0.15s; }
.form-input:focus { border-color: var(--indigo-500); }
.form-input::placeholder { color: var(--text-muted); }
textarea.form-input { resize: vertical; min-height: 80px; }
.form-hint     { font-size: 12px; color: var(--text-muted); margin-top: 6px; }
.form-hint code { background: var(--bg-hover); padding: 2px 6px; border-radius: var(--radius-sm); font-size: 11px; color: var(--indigo-400); }
.form-actions  { display: flex; gap: 12px; align-items: center; margin-top: 8px; }
</style>