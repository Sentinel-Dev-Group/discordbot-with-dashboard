<% locals.activePage = 'twitch' %>

<div class="page-header">
  <div class="page-header-left">
    <h2>Twitch Notifications</h2>
    <p class="page-subtitle">
      Tracked streamers for <strong><%= guild.discord?.name ?? guild.name %></strong>
    </p>
  </div>
  <div class="page-header-right">
    <span class="badge badge-indigo">
      <%= streamers.length %>/25 tracked
    </span>
  </div>
</div>

<!-- ─── Add streamer form ─────────────────────────────── -->
<div class="card mb-4">
  <div class="card-header">
    <h3><i data-feather="plus-circle"></i> Add streamer</h3>
  </div>
  <div class="card-body">
    <form method="POST" action="/dashboard/<%= guild.id %>/twitch/add">
      <div class="form-row">
        <div class="form-group flex-1">
          <label class="form-label">Twitch username</label>
          <input
            type="text"
            name="username"
            placeholder="e.g. shroud"
            class="form-input"
            required
          >
        </div>
        <div class="form-group flex-1">
          <label class="form-label">Notification channel ID</label>
          <input
            type="text"
            name="channel_id"
            placeholder="e.g. 123456789012345678"
            class="form-input"
            required
          >
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Custom message <span class="form-optional">(optional)</span></label>
        <input
          type="text"
          name="custom_message"
          placeholder="{streamer} is now live playing {game}! {url}"
          class="form-input"
        >
        <p class="form-hint">
          Tokens:
          <code>{streamer}</code>
          <code>{title}</code>
          <code>{game}</code>
          <code>{url}</code>
        </p>
      </div>
      <button type="submit" class="btn btn-primary">
        <i data-feather="plus"></i>
        Add streamer
      </button>
    </form>
  </div>
</div>

<!-- ─── Tracked streamers ─────────────────────────────── -->
<div class="card">
  <div class="card-header">
    <h3><i data-feather="twitch"></i> Tracked streamers</h3>
  </div>
  <div class="card-body p-0">
    <% if (streamers.length === 0) { %>
      <div class="empty-state-full">
        <i data-feather="tv"></i>
        <p>No streamers being tracked yet.</p>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>Streamer</th>
              <th>Status</th>
              <th>Channel</th>
              <th>Custom message</th>
              <th>EventSub</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% streamers.forEach(streamer => { %>
              <tr>
                <td>
                  
                    href="https://twitch.tv/<%= streamer.twitch_login %>"
                    target="_blank"
                    class="twitch-link"
                  >
                    <div class="twitch-icon">T</div>
                    <%= streamer.twitch_login %>
                  </a>
                </td>
                <td>
                  <% if (streamer.live) { %>
                    <span class="badge badge-danger">
                      🔴 Live
                    </span>
                  <% } else { %>
                    <span class="badge badge-success-soft">
                      ⚫ Offline
                    </span>
                  <% } %>
                </td>
                <td class="td-muted">
                  <code>#<%= streamer.channel_id %></code>
                </td>
                <td class="td-muted td-reason">
                  <%= streamer.custom_message
                    ? streamer.custom_message.slice(0, 50) + (streamer.custom_message.length > 50 ? '…' : '')
                    : '—' %>
                </td>
                <td>
                  <% if (streamer.subscription_id) { %>
                    <span class="badge badge-success-soft">
                      <i data-feather="check"></i>
                      Active
                    </span>
                  <% } else { %>
                    <span class="badge badge-warning">
                      <i data-feather="alert-circle"></i>
                      Pending
                    </span>
                  <% } %>
                </td>
                <td>
                  <form
                    method="POST"
                    action="/dashboard/<%= guild.id %>/twitch/remove"
                    onsubmit="return confirm('Stop tracking <%= streamer.twitch_login %>?')"
                  >
                    <input type="hidden" name="username" value="<%= streamer.twitch_login %>">
                    <button type="submit" class="btn btn-danger btn-xs">
                      <i data-feather="trash-2"></i>
                      Remove
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<style>
.form-row       { display: flex; gap: 16px; flex-wrap: wrap; }
.form-row .flex-1 { flex: 1; min-width: 200px; }
.form-optional  { font-weight: 400; color: var(--text-muted); font-size: 12px; }
.twitch-link    { display: flex; align-items: center; gap: 8px; color: #9147ff; font-weight: 600; }
.twitch-link:hover { color: #bf94ff; }
.twitch-icon    {
  width:           28px;
  height:          28px;
  background:      #9147ff;
  border-radius:   var(--radius-sm);
  display:         flex;
  align-items:     center;
  justify-content: center;
  font-size:       13px;
  font-weight:     700;
  color:           #fff;
  flex-shrink:     0;
}
</style>