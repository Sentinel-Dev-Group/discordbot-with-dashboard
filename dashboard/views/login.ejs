<% locals.activePage = 'login' %>

<div class="auth-wrapper">
  <div class="auth-card">

    <!-- Brand -->
    <div class="auth-brand">
      <div class="auth-brand-icon">N</div>
      <h1 class="auth-brand-name">Nova Bot</h1>
    </div>

    <!-- Heading -->
    <div class="auth-heading">
      <h2>Welcome back</h2>
      <p>Sign in with your Discord account to manage your servers.</p>
    </div>

    <!-- Flash error -->
    <% if (error && error.length > 0) { %>
      <div class="flash flash-error flash-inline">
        <i data-feather="alert-circle"></i>
        <%= error[0] %>
      </div>
    <% } %>

    <!-- Login button -->
    <a href="/auth/login" class="btn btn-discord btn-lg btn-full">
      <svg class="discord-icon" viewBox="0 0 24 24" fill="currentColor">
        <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.001.022.015.04.036.052a19.9 19.9 0 0 0 5.993 3.03.077.077 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .036-.051c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/>
      </svg>
      Continue with Discord
    </a>

    <!-- Divider -->
    <div class="auth-divider">
      <span>What you'll get access to</span>
    </div>

    <!-- Feature list -->
    <ul class="auth-features">
      <li>
        <i data-feather="check"></i>
        View and edit per-server configuration
      </li>
      <li>
        <i data-feather="check"></i>
        Browse command logs and audit history
      </li>
      <li>
        <i data-feather="check"></i>
        Manage warnings and bans
      </li>
      <li>
        <i data-feather="check"></i>
        View the XP leaderboard
      </li>
    </ul>

    <!-- Footer note -->
    <p class="auth-note">
      Only servers where you have <strong>Manage Server</strong> permission
      will be accessible. Nova Bot only reads your Discord identity and
      guild list — nothing else.
    </p>

  </div>

  <!-- Background orbs for depth -->
  <div class="auth-orb auth-orb-1"></div>
  <div class="auth-orb auth-orb-2"></div>
</div>